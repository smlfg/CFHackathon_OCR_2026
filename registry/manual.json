{
  "defaults": {
    "runtime": "mlx",
    "fmt": "auto",
    "max_edge": 1536,
    "temperature": 0.0,
    "max_tokens": 4096,
    "prompt": "Convert the table in this image into one HTML table: <table><tr><td>...</td></tr></table>. Keep merged cells with rowspan/colspan. Copy every cell's text exactly, character for character. Output only the HTML table, no explanation."
  },
  "specialists": [
    {
      "id": "paddleocr-vl",
      "name": "PaddleOCR-VL 0.9B",
      "hf_repo": "mlx-community/PaddleOCR-VL-8bit",
      "params_b": 0.9,
      "quant": "8bit",
      "prompt": "Table Recognition:",
      "fmt": "otsl",
      "max_edge": 0,
      "note": "native OTSL output; regression anchor, must reproduce 0.957 on dev"
    },
    {
      "id": "lighton-ocr-3-0.8b",
      "name": "LightOnOCR-3 0.8B",
      "hf_repo": "fwgpiyawudk/LightOnOCR-3-0.8B-MLX-8bit",
      "params_b": 0.8,
      "quant": "8bit",
      "prompt": "",
      "fmt": "auto",
      "max_edge": 2048,
      "note": "chat prompt is empty by design; regression anchor, must reproduce 0.9177 on dev"
    },
    {
      "id": "dots-ocr",
      "name": "dots.ocr 3B",
      "hf_repo": "mlx-community/dots.ocr-8bit",
      "params_b": 3.0,
      "quant": "8bit",
      "prompt": "Table Recognition:",
      "fmt": "auto",
      "max_edge": 0
    },
    {
      "id": "deepseek-ocr",
      "name": "DeepSeek-OCR 3B",
      "hf_repo": "mlx-community/DeepSeek-OCR-8bit",
      "params_b": 3.0,
      "quant": "8bit",
      "prompt": "<image>\n<|grounding|>Convert the document to markdown.",
      "fmt": "auto",
      "max_edge": 0
    },
    {
      "id": "deepseek-ocr-2",
      "name": "DeepSeek-OCR-2 3B",
      "hf_repo": "mlx-community/DeepSeek-OCR-2-8bit",
      "params_b": 3.0,
      "quant": "8bit",
      "prompt": "<image>\n<|grounding|>Convert the document to markdown.",
      "fmt": "auto",
      "max_edge": 0
    },
    {
      "id": "nanonets-ocr2-3b",
      "name": "Nanonets-OCR2 3B",
      "hf_repo": "mlx-community/Nanonets-OCR2-3B-8bit",
      "params_b": 3.0,
      "quant": "8bit",
      "prompt": "Convert the table in this image to HTML.",
      "fmt": "auto",
      "max_edge": 0
    },
    {
      "id": "olmocr-2-7b",
      "name": "olmOCR-2 7B",
      "hf_repo": "mlx-community/olmOCR-2-7B-1025-mlx-8bit",
      "params_b": 7.0,
      "quant": "8bit",
      "prompt": "Convert the table in this image to HTML.",
      "fmt": "auto",
      "max_edge": 1288
    },
    {
      "id": "mineru2.5-1.2b",
      "name": "MinerU2.5 1.2B",
      "hf_repo": "mlx-community/MinerU2.5-2509-1.2B-bf16",
      "params_b": 1.2,
      "quant": "bf16",
      "prompt": "Table Recognition:",
      "fmt": "auto",
      "max_edge": 0
    },
    {
      "id": "chandra-ocr-2",
      "name": "Chandra OCR 2",
      "hf_repo": "mlx-community/chandra-ocr-2-oQ8",
      "params_b": 9.0,
      "quant": "8bit",
      "prompt": "Convert the table in this image to HTML.",
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "id": "granite-docling-258m",
      "name": "Granite-Docling 258M",
      "hf_repo": "ibm-granite/granite-docling-258M-mlx",
      "params_b": 0.26,
      "quant": "bf16",
      "prompt": "Convert this page to docling.",
      "fmt": "doctags",
      "max_edge": 0
    },
    {
      "id": "smoldocling-256m",
      "name": "SmolDocling 256M",
      "hf_repo": "docling-project/SmolDocling-256M-preview-mlx-bf16",
      "params_b": 0.26,
      "quant": "bf16",
      "prompt": "Convert this page to docling.",
      "fmt": "doctags",
      "max_edge": 0
    },
    {
      "id": "got-ocr2",
      "name": "GOT-OCR2.0 0.58B",
      "hf_repo": "mlx-community/GOT-OCR2_0-bf16",
      "params_b": 0.58,
      "quant": "bf16",
      "prompt": "OCR with format: ",
      "fmt": "auto",
      "max_edge": 0
    },
    {
      "id": "qwen3-vl-4b",
      "name": "Qwen3-VL 4B Instruct",
      "hf_repo": "lmstudio-community/Qwen3-VL-4B-Instruct-MLX-4bit",
      "params_b": 4.0,
      "quant": "4bit",
      "prompt": null,
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "id": "qwen3-vl-8b",
      "name": "Qwen3-VL 8B Instruct",
      "hf_repo": "lmstudio-community/Qwen3-VL-8B-Instruct-MLX-4bit",
      "params_b": 8.0,
      "quant": "4bit",
      "prompt": null,
      "fmt": "auto",
      "max_edge": 1536
    }
  ],
  "ocrbench": [
    {
      "match": "^Qwen3\\.5-9B",
      "id": "qwen3.5-9b",
      "name": "Qwen3.5 9B",
      "hf_repo": "lmstudio-community/Qwen3.5-9B-MLX-4bit",
      "params_b": 9.0,
      "quant": "4bit",
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "match": "^GLM-4\\.6V-Flash",
      "id": "glm-4.6v-flash",
      "name": "GLM-4.6V-Flash 9B",
      "hf_repo": "lmstudio-community/GLM-4.6V-Flash-MLX-4bit",
      "params_b": 9.0,
      "quant": "4bit",
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "match": "^Gemma 4 12B",
      "id": "gemma-4-12b",
      "name": "Gemma 4 12B",
      "hf_repo": "lmstudio-community/gemma-4-12B-it-MLX-4bit",
      "params_b": 12.0,
      "quant": "4bit",
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "match": "^InternVL3-8B$",
