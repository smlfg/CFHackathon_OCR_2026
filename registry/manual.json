      "hf_repo": "mlx-community/pixtral-12b-4bit",
      "params_b": 12.0,
      "quant": "4bit",
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "match": "^Qwen2\\.5-VL-7B",
      "id": "qwen2.5-vl-7b",
      "name": "Qwen2.5-VL 7B",
      "hf_repo": "mlx-community/Qwen2.5-VL-7B-Instruct-4bit",
      "params_b": 7.0,
      "quant": "4bit",
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "match": "^Molmo2-8B",
      "id": "molmo2-8b",
      "name": "Molmo2 8B",
      "hf_repo": "mlx-community/Molmo2-8B-4bit",
      "params_b": 8.0,
      "quant": "4bit",
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "match": "^Ministral-3-14B",
      "id": "ministral-3-14b",
      "name": "Ministral 3 14B (8B build)",
      "hf_repo": "mlx-community/Ministral-3-8B-Instruct-2512-4bit",
      "params_b": 14.0,
      "quant": "4bit",
      "fmt": "auto",
      "max_edge": 1536,
      "note": "no 14B MLX build; measured on the 8B sibling, keep out of the direct ranking or mark clearly"
    },
    {
      "match": "^MiniCPM-V-4\\.6",
      "id": "minicpm-v-4.6",
      "name": "MiniCPM-V 4.6",
      "hf_repo": "mlx-community/MiniCPM-V-4.6-4bit",
      "params_b": 1.0,
      "quant": "4bit",
      "fmt": "auto",
      "max_edge": 1536
    },
    {
      "match": "^dots\\.mocr",
      "id": "dots-mocr",
      "name": "dots.mocr 3B",
      "hf_repo": "mlx-community/dots.mocr-8bit",
      "params_b": 3.0,
      "quant": "8bit",
